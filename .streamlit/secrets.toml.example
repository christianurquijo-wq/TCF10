# Copiar como .streamlit/secrets.toml (local) o pegar en Streamlit Cloud > Settings > Secrets.
# Sin [tcf10] sheet_id + sis_dataset + [gcp_service_account] la app corre en MODO DEMO.

[tcf10]
# sheet_id = "ID_DEL_GOOGLE_SHEET_OPERATIVO" # base operativa (pestañas BENEFICIARIOS y COHORTES); sin ella, base = SIS
sis_sheet_id = "ID_DEL_SHEET_CON_LAS_VISTAS_VTD10"  # copia del SIS en Sheets (opción sin BigQuery)
# sis_dataset = "potent-poetry-284019.DVTD_SIS"     # alternativa: BigQuery directo
bq_project = "potent-poetry-284019"           # proyecto donde corre (y se cobra) la consulta
horas_por_sesion = 3.0                         # horas sincrónicas que vale cada sesión asistida
divisor_time_view = 3600                       # time_view en segundos → 3600; en minutos → 60

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"

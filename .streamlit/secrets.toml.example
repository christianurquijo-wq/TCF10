# Copiar como .streamlit/secrets.toml (local) o pegar en Streamlit Cloud > Settings > Secrets.
# Sin [tcf10] sheet_id + sis_dataset + [gcp_service_account] la app corre en MODO DEMO.

[tcf10]
sheet_id = "ID_DEL_GOOGLE_SHEET_OPERATIVO"   # pestañas BENEFICIARIOS y COHORTES
sis_dataset = "proyecto.dataset_sis"          # dataset del SIS Kuepa en BigQuery
bq_project = "proyecto-de-facturacion"
horas_por_sesion = 3.0                         # horas sincrónicas que vale cada sesión asistida

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"

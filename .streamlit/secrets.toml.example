# Copiar como .streamlit/secrets.toml (local) o pegar en Streamlit Cloud > Settings > Secrets.
# Sin [tcf10] sheet_id + sis_dataset + [gcp_service_account] la app corre en MODO DEMO.

[tcf10]
sheet_id = "115IL56rZ1gLl88IIaFUdySDh9IqrnSeMDhoyCPceJZ8"  # DB Formalización TCF10 (base de estudiantes, en vivo)
sis_dataset = "potent-poetry-284019.DVTD_SIS"      # SIS directo desde BigQuery (tiene prioridad)
bq_project = "potent-poetry-284019"                # proyecto donde corren las consultas (Job User)
# sis_sheet_id = "ID_DEL_SHEET_VTD10"              # respaldo: copia del SIS en Sheets (si no hay sis_dataset)
divisor_time_view = 3600                       # time_view en segundos → 3600; en minutos → 60

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
